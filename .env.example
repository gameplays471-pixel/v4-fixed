# ═══════════════════════════════════════════════════════════════════════
# GEMgym — Variáveis de ambiente
# Copie para .env.local e preencha os valores
# ═══════════════════════════════════════════════════════════════════════

# ─── Segurança (OBRIGATÓRIO em produção) ────────────────────────────────
# Segredo de assinatura JWT (HS256). Mínimo 32 caracteres (256 bits).
# Gerar com: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# ⚠️ NUNCA usar o valor default em produção — tokens podem ser forjados!
SESSION_SECRET=

# Forçar cookie Secure mesmo fora do Vercel (útil em staging com HTTPS)
# FORCE_SECURE_COOKIE=1

# ─── Banco de dados (Supabase/PostgreSQL) ───────────────────────────────
DATABASE_URL=
DIRECT_URL=

# ─── Supabase ───────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ─── Sentry (monitoramento de erros) ───────────────────────────────────
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
NEXT_PUBLIC_SENTRY_DSN=

# ─── Vercel Blob (upload de fotos) ─────────────────────────────────────
BLOB_READ_WRITE_TOKEN=

# ─── WebSocket ──────────────────────────────────────────────────────────
# Origins permitidas para CORS do WebSocket (separadas por vírgula)
# Em dev: http://localhost:3000,http://localhost:3001
# Em prod: https://gemgym.com.br,https://www.gemgym.com.br
WS_ALLOWED_ORIGINS=

# ─── Node ───────────────────────────────────────────────────────────────
NODE_ENV=development
