# Copie este arquivo para .env e preencha com suas credenciais do Supabase
#
# Como obter as URLs:
# 1. Acesse https://supabase.com → seu projeto
# 2. Project Settings → Connectivity → Connection string
# 3. Use a aba "Pooler" (não a "Direct connection")
#
# DATABASE_URL: pooler transacional (porta 6543 com pgbouncer=true)
#   - Necessário para Vercel serverless (funções efêmeras precisam de pool)
#   - Funciona para dev local também
#
# DIRECT_URL: pooler sessão (porta 5432, sem pgbouncer)
#   - Usado pelo Prisma para migrations (db push, migrate)
#   - Não pode ter pgbouncer=true em migrations
#
# Substitua <SUA_SENHA> pela senha do banco (criada no Supabase)

DATABASE_URL=postgresql://postgres.<PROJECT-REF>:<SUA_SENHA>@aws-1-us-west-2.pooler.supabase.com:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres.<PROJECT-REF>:<SUA_SENHA>@aws-1-us-west-2.pooler.supabase.com:5432/postgres

# Segredo para assinar tokens JWT (mínimo 32 caracteres, gere com: openssl rand -base64 32)
JWT_SECRET=5mKZ/SRfOSeLAnQCZYd4kPPcSjYGmZ6an0SB0ne0n0o=